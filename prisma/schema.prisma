generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  CLIENTE
  TRABAJADOR
}

enum PublicacionEstado {
  ABIERTA
  EN_PROGRESO
  COMPLETADA
}

// ----------------------------------------------------
// MODELOS / TABLAS
// ----------------------------------------------------

model Usuario {
  id                    String            @id @default(uuid())
  nombre                String            @db.VarChar(100)
  apellido              String            @db.VarChar(100)
  email                 String            @unique @db.VarChar(150)
  telefono              String            @unique @db.VarChar(20)
  passwordHash          String            @db.VarChar(255)
  rol                   Role
  fotoUrl               String?           @db.Text
  activo                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  perfilTrabajador      PerfilTrabajador?
  publicaciones         Publicacion[]
  resenasComoCliente    Resena[]          @relation("ResenasCliente")
  resenasComoTrabajador Resena[]          @relation("ResenasTrabajador")
  refreshTokens         RefreshToken[]

  @@index([rol])
}

model PerfilTrabajador {
  id            String             @id @default(uuid())
  usuarioId     String             @unique
  descripcion   String?            @db.Text
  experiencia   String?            @db.Text
  zonaCobertura String             @db.VarChar(150)
  disponible    Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  oficios       TrabajadorOficio[]

  @@index([zonaCobertura])
  @@index([disponible])
}

model Categoria {
  id          String   @id @default(uuid())
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  oficios     Oficio[]

  @@index([activo])
}

model Oficio {
  id            String             @id @default(uuid())
  categoriaId   String
  nombre        String             @unique @db.VarChar(100)
  descripcion   String?            @db.Text
  activo        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  
  categoria     Categoria          @relation(fields: [categoriaId], references: [id])
  trabajadores  TrabajadorOficio[]
  publicaciones Publicacion[]

  @@index([categoriaId])
  @@index([activo])
}

model TrabajadorOficio {
  trabajadorId String
  oficioId     String
  principal    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  
  trabajador   PerfilTrabajador @relation(fields: [trabajadorId], references: [id])
  oficio       Oficio           @relation(fields: [oficioId], references: [id])

  @@id([trabajadorId, oficioId])
  @@index([oficioId])
  @@index([trabajadorId])
}

model Publicacion {
  id          String            @id @default(uuid())
  clienteId   String
  oficioId    String
  titulo      String            @db.VarChar(150)
  descripcion String            @db.Text
  ubicacion   String            @db.VarChar(200)
  presupuesto Decimal?          @db.Decimal(10, 2)
  estado      PublicacionEstado @default(ABIERTA)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  cliente     Usuario           @relation(fields: [clienteId], references: [id])
  oficio      Oficio            @relation(fields: [oficioId], references: [id])
  resena      Resena?

  @@index([clienteId])
  @@index([oficioId])
  @@index([estado])
  @@index([ubicacion])
  @@index([createdAt])
}

model Resena {
  id            String      @id @default(uuid())
  clienteId     String
  trabajadorId  String
  publicacionId String      @unique
  calificacion  Int         @db.SmallInt
  comentario    String?     @db.Text
  createdAt     DateTime    @default(now())
  
  cliente       Usuario     @relation("ResenasCliente", fields: [clienteId], references: [id])
  trabajador    Usuario     @relation("ResenasTrabajador", fields: [trabajadorId], references: [id])
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id])

  @@index([trabajadorId])
  @@index([clienteId])
  @@index([publicacionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([expiresAt])
}