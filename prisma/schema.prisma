generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CLIENTE
  TRABAJADOR
}

enum PublicacionEstado {
  ABIERTA
  EN_PROGRESO
  COMPLETADA
}

model Usuario {
  id                    String            @id @default(uuid()) @db.Char(36)
  nombre                String            @db.VarChar(100)
  apellido              String            @db.VarChar(100)
  email                 String            @unique @db.VarChar(150)
  telefono              String            @unique @db.VarChar(20)
  passwordHash          String            @map("password_hash") @db.VarChar(255)
  rol                   Role
  fotoUrl               String?           @map("foto_url") @db.Text
  activo                Boolean           @default(true)
  createdAt             DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  perfilTrabajador      PerfilTrabajador?
  publicaciones         Publicacion[]
  resenasComoCliente    Resena[]          @relation("ResenasCliente")
  resenasComoTrabajador Resena[]          @relation("ResenasTrabajador")
  refreshTokens         RefreshToken[]

  @@index([rol])
  @@map("usuarios")
}

model PerfilTrabajador {
  id            String             @id @default(uuid()) @db.Char(36)
  usuarioId     String             @unique @map("usuario_id") @db.Char(36)
  descripcion   String?            @db.Text
  experiencia   String?            @db.Text
  zonaCobertura String             @map("zona_cobertura") @db.VarChar(150)
  disponible    Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  usuario       Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  oficios       TrabajadorOficio[]

  @@index([zonaCobertura])
  @@index([disponible])
  @@map("perfiles_trabajador")
}

model Categoria {
  id          String   @id @default(uuid()) @db.Char(36)
  nombre      String   @unique @db.VarChar(100)
  descripcion String?  @db.Text
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  oficios     Oficio[]

  @@index([activo])
  @@map("categorias")
}

model Oficio {
  id            String             @id @default(uuid()) @db.Char(36)
  categoriaId   String             @map("categoria_id") @db.Char(36)
  nombre        String             @unique @db.VarChar(100)
  descripcion   String?            @db.Text
  activo        Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)

  categoria     Categoria          @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  trabajadores  TrabajadorOficio[]
  publicaciones Publicacion[]

  @@index([categoriaId])
  @@index([activo])
  @@map("oficios")
}

model TrabajadorOficio {
  trabajadorId String           @map("trabajador_id") @db.Char(36)
  oficioId     String           @map("oficio_id") @db.Char(36)
  principal    Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  trabajador   PerfilTrabajador @relation(fields: [trabajadorId], references: [id], onDelete: Cascade)
  oficio       Oficio           @relation(fields: [oficioId], references: [id], onDelete: Restrict)

  @@id([trabajadorId, oficioId])
  @@index([oficioId])
  @@index([trabajadorId])
  @@map("trabajador_oficios")
}

model Publicacion {
  id          String            @id @default(uuid()) @db.Char(36)
  clienteId   String            @map("cliente_id") @db.Char(36)
  oficioId    String            @map("oficio_id") @db.Char(36)
  titulo      String            @db.VarChar(150)
  descripcion String            @db.Text
  ubicacion   String            @db.VarChar(200)
  presupuesto Decimal?          @db.Decimal(10, 2)
  estado      PublicacionEstado @default(ABIERTA)
  createdAt   DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  cliente     Usuario           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  oficio      Oficio            @relation(fields: [oficioId], references: [id], onDelete: Restrict)
  resena      Resena?

  @@index([clienteId])
  @@index([oficioId])
  @@index([estado])
  @@index([ubicacion])
  @@index([createdAt])
  @@map("publicaciones")
}

model Resena {
  id            String      @id @default(uuid()) @db.Char(36)
  clienteId     String      @map("cliente_id") @db.Char(36)
  trabajadorId  String      @map("trabajador_id") @db.Char(36)
  publicacionId String      @unique @map("publicacion_id") @db.Char(36)
  calificacion  Int         @db.SmallInt
  comentario    String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  cliente       Usuario     @relation("ResenasCliente", fields: [clienteId], references: [id], onDelete: Restrict)
  trabajador    Usuario     @relation("ResenasTrabajador", fields: [trabajadorId], references: [id], onDelete: Restrict)
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Restrict)

  @@index([trabajadorId])
  @@index([clienteId])
  @@index([publicacionId])
  @@index([clienteId, publicacionId])
  @@map("resenas")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  usuarioId String    @map("usuario_id") @db.Char(36)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}